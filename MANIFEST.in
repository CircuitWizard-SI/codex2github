include LICENSE README.md SECURITY.md
include config.example.json CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include scripts *.py *.ps1
recursive-include src/codex2github *.py
recursive-include tests *.py
prune .runtime
prune .test-runtime
prune .venv
prune workspace
prune repository
prune jobs
prune sessions
prune archived_sessions
exclude config.json
exclude config.local*.json
global-exclude *.db *.sqlite *.jsonl *.jsonl.zst *.log *.lock *.pyc
